# Скопируйте в .env и заполните. Файл .env в git не добавляется.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite
# Папка с базой данных (orientir.db). Локально, например: ./data
ORIENTIR_DATA=./data
# Логин и пароль первого администратора (создаётся при пустой базе)
ORIENTIR_ADMIN_LOGIN=admin
ORIENTIR_ADMIN_PASSWORD=
